{
  "manifest_version": 3,
  "name": "SIT ADFS TOTP Autofill",
  "version": "0.5.1",
  "description": "芝浦工業大学ADFSのID・パスワード、Azure MFA選択、SHA-256 TOTP入力を自動化します。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://adfs.sic.shibaura-it.ac.jp/adfs/ls*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SIT ADFS TOTP Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://adfs.sic.shibaura-it.ac.jp/adfs/ls*"
      ],
      "js": [
        "content.js",
        "diagnostics.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
